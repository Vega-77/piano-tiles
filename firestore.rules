rules_version = '2';

// Paste these into Firebase console > Firestore Database > Rules, then Publish.
//
// Everything a player syncs lives under users/{their uid}/..., and only that signed-in person can
// read or write it. Nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

// Optional, so strangers who sign in can't use up your free quota: swap the rule above for this one
// and put your own uid (Authentication > Users > "User UID") where it says YOUR-UID-HERE. Keep the
// uid in the console; don't commit it.
//
//     match /users/{uid}/{document=**} {
//       allow read, write: if request.auth != null
//                          && request.auth.uid == uid
//                          && uid == 'YOUR-UID-HERE';
//     }
